# ------------------------------------------------------------------------------
# HOSPITAL REST API ENVIRONMENT VARIABLES (RUNNING ON APP1)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# KẾT NỐI POSTGRESQL QUA HAPROXY (PORT 5000: PRIMARY GHI/ĐỌC)
DB_HOST=127.0.0.1
DB_PORT=5000
DB_NAME=hospital_db
DB_USER=hospital_app_user
DB_PASSWORD=CHANGE_ME_APP_SECRET_2026

# CONNECTION POOL & FAILOVER RESILIENCE SETTINGS
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=3000

# THIẾT LẬP THỬ LẠI KHI CỤM FAILOVER
# Khi Primary chết và Patroni bầu chọn Primary mới (khoảng 10-15s),
# Client pool sẽ retry với exponential backoff để không làm sập ứng dụng.
DB_MAX_RETRIES=8
DB_RETRY_DELAY_MS=1500
