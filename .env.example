# ==============================================================================
# HOSPITAL DATABASE HIGH AVAILABILITY (HA) CLUSTER - ENVIRONMENT CONFIGURATION
# Mạng ảo Tailscale • Ubuntu 22.04 LTS • PostgreSQL 14 • 5 Máy Chủ
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. QUY HOẠCH ĐỊA CHỈ MẠNG TAILSCALE & HOSTNAME (5 NODES THỰC TẾ)
# ------------------------------------------------------------------------------
CLUSTER_SUBNET="100.64.0.0/10"
NET_INTERFACE="tailscale0"

DB1_HOSTNAME="db1"
DB1_IP="100.115.205.94"

DB2_HOSTNAME="db2"
DB2_IP="100.97.242.2"

DB3_HOSTNAME="db3"
DB3_IP="100.67.87.46"

APP1_HOSTNAME="app1"
APP1_IP="100.99.89.64"

MON1_HOSTNAME="mon1"
MON1_IP="100.87.112.76"

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH POSTGRESQL & PATRONI (CHUẨN UBUNTU 22.04 LTS)
# ------------------------------------------------------------------------------
PG_VERSION="14"
PG_CLUSTER_NAME="hospital-ha-cluster"
PG_DATA_DIR="/var/lib/postgresql/14/main"
PG_BIN_DIR="/usr/lib/postgresql/14/bin"
PG_PORT="5432"

PATRONI_PORT="8008"
PATRONI_CONFIG_PATH="/etc/patroni/patroni.yml"
PATRONI_USER="patroni"

# Tùy chọn đồng bộ: "false" (async - tối ưu cho mạng Tailscale)
PATRONI_SYNCHRONOUS_MODE="false"

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH ETCD CLUSTER (3 MEMBERS QUORUM: DB1, DB2, DB3 QUA TAILSCALE)
# ------------------------------------------------------------------------------
ETCD_CLUSTER_TOKEN="etcd-hospital-tailscale-token"
ETCD_CLIENT_PORT="2379"
ETCD_PEER_PORT="2380"
ETCD_INITIAL_CLUSTER="db1=http://100.115.205.94:2380,db2=http://100.97.242.2:2380,db3=http://100.67.87.46:2380"

# ------------------------------------------------------------------------------
# 4. TÀI KHOẢN VÀ MẬT KHẨU CƠ SỞ DỮ LIỆU
# ------------------------------------------------------------------------------
POSTGRES_ADMIN_USER="postgres"
POSTGRES_ADMIN_PASSWORD="Hospital@2026!Admin"

PG_REP_USER="replicator"
PG_REP_PASSWORD="Hospital@2026!Replication"

PATRONI_API_USER="patroni_api"
PATRONI_API_PASSWORD="Hospital@2026!Patroni"

APP_DB_NAME="hospital_db"
APP_DB_USER="hospital_app_user"
APP_DB_PASSWORD="Hospital@2026!AppPass"

# ------------------------------------------------------------------------------
# 5. HAPROXY CONFIGURATION (TRÊN MÁY APP1)
# ------------------------------------------------------------------------------
HAPROXY_PRIMARY_PORT="5000"
HAPROXY_STANDBY_PORT="5001"
HAPROXY_STATS_PORT="7000"
HAPROXY_STATS_USER="admin"
HAPROXY_STATS_PASSWORD="Hospital@2026!Stats"

# ------------------------------------------------------------------------------
# 6. NODE.JS HOSPITAL API (TRÊN MÁY APP1)
# ------------------------------------------------------------------------------
APP_PORT="3000"
APP_ENV="production"
NODE_ENV="production"
JWT_SECRET="c8e6f1a4891b29a00f2e4b3c7d8e9f01"

# Ứng dụng kết nối tới PostgreSQL THÔNG QUA HAProxy trên localhost của APP1
DB_CONNECTION_HOST="127.0.0.1"
DB_CONNECTION_PORT="5000"
DB_POOL_MAX="20"
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_CONNECTION_TIMEOUT_MS="5000"

# ------------------------------------------------------------------------------
# 7. PGBACKREST BACKUP CONFIGURATION (KHO TẬP TRUNG TRÊN MON1 QUA TAILSCALE)
# ------------------------------------------------------------------------------
PGBACKREST_STANZA="hospital_cluster"
PGBACKREST_REPO_PATH="/var/lib/pgbackrest"
PGBACKREST_REPO_USER="postgres"
PGBACKREST_LOG_PATH="/var/log/pgbackrest"
PGBACKREST_RETENTION_FULL="2"
PGBACKREST_RETENTION_DIFF="7"

# ------------------------------------------------------------------------------
# 8. GIÁM SÁT PROMETHEUS & GRAFANA (TRÊN MON1 QUA TAILSCALE)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT="9090"
GRAFANA_PORT="3001"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="Hospital@2026!Grafana"

NODE_EXPORTER_PORT="9100"
POSTGRES_EXPORTER_PORT="9187"
HAPROXY_EXPORTER_PORT="9101"
