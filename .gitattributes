# Force LF line endings for all text files across Windows and Linux
* text=auto eol=lf

# Explicit bash scripts and config files must always use LF
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
.env* text eol=lf
