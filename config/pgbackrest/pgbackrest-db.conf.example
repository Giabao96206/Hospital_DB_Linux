# ==============================================================================
# PGBACKREST CLIENT CONFIGURATION FOR DB NODES (DB1, DB2, DB3 - TAILSCALE)
# Đường dẫn triển khai trên máy DB: /etc/pgbackrest.conf
# Quyền sở hữu: chown postgres:postgres /etc/pgbackrest.conf && chmod 640
# ==============================================================================

[global]
repo1-host=100.87.112.76          # Địa chỉ Tailscale của máy MON1 (Kho sao lưu tập trung)
repo1-host-user=postgres
process-max=2
log-level-console=info
log-level-file=detail
start-fast=y
compress-type=lz4

[hospital_cluster]
pg1-path=/var/lib/postgresql/14/main
pg1-user=postgres
